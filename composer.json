{
    "name": "shipaurora/minimal",
    "description": "A minimal admin theme for Aurora CMS: quiet, flat and neutral, in light and dark.",
    "keywords": [
        "aurora",
        "aurora-cms",
        "aurora-cms-theme",
        "cms",
        "laravel",
        "filament",
        "filament-theme",
        "admin-theme",
        "theme",
        "dark-mode",
        "minimal",
        "tailwindcss"
    ],
    "homepage": "https://shipaurora.com",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Thomas Alrek",
            "email": "thomas@alrek.no"
        }
    ],
    "support": {
        "issues": "https://github.com/shipaurora/minimal/issues",
        "source": "https://github.com/shipaurora/minimal"
    },
    "require": {
        "php": "^8.4",
        "shipaurora/cms": "^1.0",
        "filament/filament": "^5.11"
    },
    "replace": {
        "shipaurora/minimal-theme": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Aurora\\Minimal\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aurora\\Minimal\\ThemeServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}
