{
    "name": "aurora/minimal",
    "description": "A minimal admin theme for Aurora CMS: quiet, flat and neutral, in light and dark.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "aurora/cms": "@dev",
        "filament/filament": "^5.10"
    },
    "autoload": {
        "psr-4": {
            "Aurora\\Minimal\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aurora\\Minimal\\ThemeServiceProvider"
            ]
        }
    }
}
